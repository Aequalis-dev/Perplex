local cha = {
    chb = game:GetService("Players"),
    chc = game:GetService("Players").LocalPlayer,
    chd = nil
}

local function che()
    if cha.chd then
        cha.chd:Destroy()
        cha.chd = nil
    end
    if cha.chc.Character then
        for _, obj in pairs(cha.chc.Character:GetChildren()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
                obj.Transparency = 0
            elseif obj:IsA("Accessory") and obj:FindFirstChild("Handle") then
                obj.Handle.Transparency = 0
            end
        end
    end
end

user:CreateInput({
    name = "Morph into Player",
