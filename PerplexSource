    fb = false,
    fc = 50,
    fd = game:GetService("Players").LocalPlayer,
    fe = game:GetService("RunService"),
    ff = nil,
    fg = nil
}

carConfig:CreateSwitch({
    name = "Car Fly",
    Callback = function(h)
        fa.fb = h
        if not fa.fb then
            if fa.ff then fa.ff:Destroy() fa.ff = nil end
            if fa.fg then fa.fg:Destroy() fa.fg = nil end
        end
    end
