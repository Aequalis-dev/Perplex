        fa.fc = h
    end
})

fa.fe.RenderStepped:Connect(function()
    if fa.fb and fa.fd.Character and fa.fd.Character:FindFirstChild("Humanoid") then
        local seat = fa.fd.Character.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") then
            local root = seat.AssemblyRootPart
            if root then
                if not fa.ff then
                    fa.ff = Instance.new("BodyVelocity")
                    fa.ff.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    fa.ff.Parent = root
                end
                if not fa.fg then
                    fa.fg = Instance.new("BodyGyro")
                    fa.fg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    fa.fg.Parent = root
                end
                
                local dir = Vector3.new(0, 0, 0)
                local u = game:GetService("UserInputService")
                local cam = workspace.CurrentCamera.CFrame
                
                if u:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
                if u:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
                if u:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
                if u:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
                if u:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
                if u:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
                
                if dir.Magnitude > 0 then
                    fa.ff.Velocity = dir.Unit * fa.fc
                else
                    fa.ff.Velocity = Vector3.new(0, 0, 0)
                end
                fa.fg.CFrame = cam
                return
            end
        end
    end
    if fa.ff then fa.ff:Destroy() fa.ff = nil end
    if fa.fg then fa.fg:Destroy() fa.fg = nil end
end)






