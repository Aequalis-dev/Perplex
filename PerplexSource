    accepted = true,
    callback = function(text)
        if text and text ~= "" then
            local targetPlayer = nil
            for _, p in pairs(cha.chb:GetPlayers()) do
                if p.Name:lower():sub(1, #text) == text:lower() then
                    targetPlayer = p
                    break
                end
            end
            
            if targetPlayer and targetPlayer.Character and cha.chc.Character then
                che()
                
                local myChar = cha.chc.Character
                local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                local targetChar = targetPlayer.Character
                
                if myRoot then
                    targetChar.Archivable = true
                    local clone = targetChar:Clone()
                    targetChar.Archivable = false
                    
                    local tRoot = clone:FindFirstChild("HumanoidRootPart")
                    local tHum = clone:FindFirstChildOfClass("Humanoid")
                    if tHum then tHum:Destroy() end
                    if tRoot then tRoot:Destroy() end
                    
                    for _, obj in pairs(myChar:GetChildren()) do
                        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
                            obj.Transparency = 1
                        elseif obj:IsA("Accessory") and obj:FindFirstChild("Handle") then
                            obj.Handle.Transparency = 1
                        end
                    end
                    
                    clone.Parent = myChar
                    cha.chd = clone
                    
                    local conn
                    conn = game:GetService("RunService").Stepped:Connect(function()
                        if clone and myChar and myRoot and cha.chd == clone then
                            clone:SetPrimaryPartCFrame(myRoot.CFrame)
                        else
                            conn:Disconnect()
                        end
                    end)
                end
            end
        end
    end
})

